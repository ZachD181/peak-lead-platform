{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/follow-up-reminders",
      "schedule": "0 14 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/go/linkedin",
      "destination": "/?utm_source=linkedin&utm_medium=social&utm_campaign=profile",
      "statusCode": 302
    },
    {
      "source": "/go/facebook",
      "destination": "/?utm_source=facebook&utm_medium=social&utm_campaign=profile",
      "statusCode": 302
    },
    {
      "source": "/go/reddit",
      "destination": "/?utm_source=reddit&utm_medium=social&utm_campaign=profile",
      "statusCode": 302
    },
    {
      "source": "/go/x",
      "destination": "/?utm_source=x&utm_medium=social&utm_campaign=profile",
      "statusCode": 302
    },
    {
      "source": "/:l([a-z0-9])",
      "destination": "/?utm_source=heycatch&utm_campaign=:l",
      "statusCode": 302
    }
  ]
}

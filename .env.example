# Peak Lead Platform environment configuration

# PostgreSQL connection string.
# Leave blank during local development to use Peak's local data store.
DATABASE_URL=

# Application environment.
# Use "development" locally and "production" when deployed.
NODE_ENV=development

# PostgreSQL SSL mode.
# Production database providers may require this.
PGSSLMODE=

# Web server port.
PORT=3000
# Meta customer connection (use one stable HTTPS host per environment)
META_APP_ID=
META_LOGIN_CONFIG_ID=
META_OAUTH_REDIRECT_URI=
